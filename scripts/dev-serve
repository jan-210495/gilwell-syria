#!/usr/bin/env bash
set -euo pipefail

# Ensure .env exists with an app key
if [ ! -f .env ]; then
    cp .env.example .env
fi

if grep -q '^APP_KEY=$' .env || ! grep -q '^APP_KEY=' .env; then
    echo "Generating APP_KEY..."
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        --env COMPOSER_HOME=/tmp/composer \
        --volume "$PWD:/app" \
        --workdir /app \
        gilwell-syria-php \
        php artisan key:generate --ansi
fi

PORT="${1:-8000}"

echo "Starting Laravel dev server on http://localhost:${PORT} ..."
docker run --rm \
    -p "${PORT}:${PORT}" \
    --user "$(id -u):$(id -g)" \
    --env COMPOSER_HOME=/tmp/composer \
    --volume "$PWD:/app" \
    --workdir /app \
    gilwell-syria-php \
    php artisan serve --host=0.0.0.0 --port="${PORT}"
