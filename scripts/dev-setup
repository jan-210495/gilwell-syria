#!/usr/bin/env bash
set -euo pipefail

echo "=== GilwellSyria Dev Setup ==="

# 1. Ensure .env exists
if [ ! -f .env ]; then
    cp .env.example .env
fi

# 2. Set DB_HOST to the Docker network name
if grep -q '^DB_HOST=127.0.0.1' .env; then
    echo "Updating DB_HOST from 127.0.0.1 to mysql (Docker network)..."
    sed -i 's/^DB_HOST=127.0.0.1/DB_HOST=mysql/' .env
fi

# 3. Build Docker images (includes Node.js now)
echo "Building Docker images..."
docker compose build

# 4. Install composer dependencies
echo "Installing PHP dependencies..."
scripts/dev-composer install --no-interaction

# 5. Install npm dependencies
echo "Installing frontend dependencies..."
scripts/dev-npm install

# 6. Build frontend assets
echo "Building frontend assets..."
scripts/dev-npm run build

# 7. Start everything (compose healthcheck waits for MySQL)
echo "Starting MySQL + PHP..."
docker compose up -d

# 8. Wait for MySQL healthcheck to pass
echo "Waiting for MySQL to be healthy..."
MAX_WAIT=60
WAITED=0
until docker compose ps mysql | grep -q "healthy" 2>/dev/null; do
    WAITED=$((WAITED + 1))
    if [ $WAITED -ge $MAX_WAIT ]; then
        echo "MySQL did not become healthy in ${MAX_WAIT}s. Check logs:"
        docker compose logs mysql
        exit 1
    fi
    sleep 1
    echo "  ${WAITED}s..."
done
echo "MySQL is healthy!"

# 9. Generate APP_KEY if missing
if grep -q '^APP_KEY=$' .env || ! grep -q '^APP_KEY=' .env; then
    echo "Generating APP_KEY..."
    docker compose exec php php artisan key:generate --ansi
fi

# 10. Run migrations + seed the database
echo "Running migrations & seeding database..."
docker compose exec php php artisan migrate:fresh --seed --force

echo ""
echo "=== Ready! Open http://localhost:8000 in your browser ==="
echo ""
echo "To stop:  docker compose down"
echo "To restart: docker compose up -d"
